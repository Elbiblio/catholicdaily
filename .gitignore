# Incipit rule master — dev-only artifacts (cached HTML + scraped data).
# Regenerated by scripts/active/grammatical_rule_master.py and
# scripts/active/scrape_external_sundays.py. NOT shipped with the app —
# only assets/incipit_rules.csv is bundled at runtime.
scripts/active/external_cache/
scripts/active/external_sundays.json
scripts/active/grammatical_golden_pairs.json
scripts/active/rule_master_report.md

